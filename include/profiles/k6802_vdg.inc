; K6802-SBC + K68-VDG表示プロファイル。
; SD/FATワークは$A000-$BFFFへ置き、K68-VDG VRAMは$C000-$DFFFを使う。

MONITOR_PROFILE_BASE equ 0
MONITOR_PROFILE_SBCIO equ 1
MONITOR_PROFILE_K6802_VDG equ 1
MONITOR_FEATURE_VDG  equ 1

RAM_START        equ $0000
RAM_END          equ $7FFF
USER_RAM_END     equ $7FFF
WORK_RAM_START   equ $A000
WORK_RAM_END     equ $BFFF
MIKBUG_VAR_BASE  equ $A300
MIKBUG_STACK_TOP equ $BFFF
MONITOR_RAM_BASE equ $A200
STACK_TOP        equ MIKBUG_STACK_TOP

SD_SECTOR_BUF    equ $A000

RAMTEST1_ENABLED equ 1
RAMTEST1_START   equ $0100
RAMTEST1_END     equ $7FFF
RAMTEST2_ENABLED equ 1
RAMTEST2_START   equ $A000
RAMTEST2_END     equ $BFFF
RAMTEST3_ENABLED equ 0
RAMTEST3_START   equ $C000
RAMTEST3_END     equ $DFFF

VDG_CTL          equ $8110
VDG_MODE         equ $00
VDG_VRAM_START   equ $C000
VDG_VRAM_END     equ $DFFF
VDG_TEXT_END      equ $C1FF
