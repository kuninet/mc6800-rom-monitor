; 案 B の BIOS 入口表（#310 の 1-6）。MIKBUG の隙間 $E0E6 から 3 バイトの jmp を 16 本並べる。
; 番地・並び・規約は ROM の ABI なので、変えると焼き直しになる。
BIOS_WBOOT       equ $E0E6
BIOS_INFO        equ $E0E9
BIOS_GET_API     equ $E0EC
BIOS_EXEC        equ $E0EF
